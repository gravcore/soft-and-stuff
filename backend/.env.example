# Server
NODE_ENV=development
PORT=3000

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis cache
REDIS_URL=redis://localhost:6379

# JWT Secret key, generation: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_64_chars_minimun_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=different_64_chars_minimum_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CSRF Secret key
CSRF_SECRET=change_me_64_chars_minimun_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ImageKit
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/ID

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/v1/media/youtube/callback
YOUTUBE_REFRESH_TOKEN=   # set once after first OAuth authorization

# Frontend
FRONTEND_URL=http://localhost:5173

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

OTP_TTL_MINUTES=5

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@domain.com

# Sentry
SENTRY_DSN=https://...@sentry.io/...

# Security
ALLOWED_ORIGINS=http://localhost:5173
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Common
BRAND_TITLE=Soft&Stuff
BRAND_SUBTITLE=Everything, in one place

# Uni Rate api
UNIRATE_API_KEY=

# Shippo api
SHIPPO_API_KEY=

# Warehouse
WAREHOUSE_ADDRESS_JSON = {"name":"Store Warehouse","street1":"1600 Pennsylvania Avanue NW","city":"Washington","state":"DC","zip":"20500","country":"US","phone":"+12024561111","email":"warehouse@mystore.com"}

# Paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=